modules = ["nodejs-20", "web"]
# Run always syncs this copy to the latest code on GitHub (main), then starts.
# Your saved data lives in data/, which git ignores, so it is never touched.
run = "GIT_TERMINAL_PROMPT=0 timeout 30 git fetch -q origin main && git reset -q --hard origin/main && echo 'Updated to latest' || echo 'Could not reach GitHub - starting the current version'; npm run start:public"

[deployment]
# Reserved VM: group sessions keep a live connection open to each phone.
deploymentTarget = "vm"
run = ["npm", "run", "start:public"]

[[ports]]
localPort = 8787
externalPort = 80

[nix]
channel = "stable-25_05"

[workflows]
runButton = "start"

[[workflows.workflow]]
name = "start"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "GIT_TERMINAL_PROMPT=0 timeout 30 git fetch -q origin main && git reset -q --hard origin/main && echo 'Updated to latest' || echo 'Could not reach GitHub - starting the current version'; npm run start:public"
waitForPort = 8787
