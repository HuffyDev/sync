modules = ["nodejs-22"]
# Stop + Run pulls the latest code from GitHub, then restarts the app.
run = "timeout 20 git pull --ff-only origin main || echo 'git pull skipped'; npm run start:public"

[deployment]
# Reserved VM: group sessions keep a live connection open to each phone.
deploymentTarget = "vm"
run = ["npm", "run", "start:public"]

[[ports]]
localPort = 8787
externalPort = 80

[workflows]
runButton = "start"

[[workflows.workflow]]
name = "start"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "timeout 20 git pull --ff-only origin main || echo 'git pull skipped'; npm run start:public"
waitForPort = 8787
